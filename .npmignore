# Exclusions layered on package.json `files` (primarily under `skills/`, caches on disk).

# Skills may vendor local test suites; runtime catalog does not require them.
skills/**/tests/
skills/**/__pycache__/

# Safety if a future layout reintroduces these under an allowlisted tree
python/tests/
python/**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
python/requirements-dev.txt

# OS / editor clutter
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
